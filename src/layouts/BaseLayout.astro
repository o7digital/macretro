---
import "../styles/global.css";
import { languageLabels, languages, localizedPath } from "../data/i18n";
const schema = Astro.props.schema ?? [];
const { contact, seo, htmlLang = "es", footerText, footerSummary } = Astro.props;
---
<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <meta name="keywords" content={seo.keywords.join(", ")} />
    <link rel="canonical" href={seo.canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content={seo.canonical} />
    <meta property="og:image" content={seo.image} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={seo.image} />
    {languages.map((lang) => <link rel="alternate" hreflang={lang} href={`https://archivomac.mx${localizedPath(lang)}`} />)}
    <link rel="alternate" hreflang="x-default" href="https://archivomac.mx/" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <slot />
    <footer>
      <a class="brand" href="#inicio"><span class="mark">AM</span><span class="brand-text"><span>{contact.brandName}</span><span class="brand-subtitle">RETROMACNIA</span></span></a>
      <p>{footerSummary}</p>
      <nav><a href="#servicios">Servicios</a><a href="#coleccion">Colección</a><a href="#contacto">Contacto</a><a href={contact.instagramUrl}>Instagram</a><span class="language-links">{languages.map((lang) => <a href={localizedPath(lang)}>{languageLabels[lang]}</a>)}</span></nav>
      <small>© 2026 {contact.brandName}. {footerText}</small>
    </footer>
  </body>
</html>
